{
    "name":  "pizza-in-pizza-api",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Production-grade e-commerce API for Pizza in Pizza",
    "license":  "MIT",
    "packageManager":  "pnpm@10.30.0",
    "scripts":  {
                    "build":  "nest build",
                    "start":  "nest start",
                    "start:dev":  "nest start --watch",
                    "start:prod":  "node dist/main",
                    "lint":  "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
                    "format":  "prettier --write .",
                    "test":  "jest",
                    "test:watch":  "jest --watch",
                    "test:cov":  "jest --coverage",
                    "test:e2e":  "jest --config ./test/jest-e2e.json",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:deploy":  "prisma migrate deploy",
                    "prisma:seed":  "ts-node prisma/seed.ts",
                    "dev":  "pnpm --parallel --filter web --filter admin dev",
                    "dev:web":  "pnpm --filter web dev",
                    "dev:admin":  "pnpm --filter admin dev",
                    "typecheck":  "pnpm -r --filter ./apps/* --filter @pizza/shared typecheck"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.992.0",
                         "@nestjs/common":  "^11.1.8",
                         "@nestjs/config":  "^4.0.2",
                         "@nestjs/core":  "^11.1.8",
                         "@nestjs/platform-express":  "^11.1.8",
                         "@nestjs/swagger":  "^11.2.1",
                         "@nestjs/throttler":  "^6.5.0",
                         "@prisma/client":  "^6.19.0",
                         "argon2":  "^0.44.0",
                         "bullmq":  "^5.69.3",
                         "helmet":  "^8.1.0",
                         "ioredis":  "^5.9.3",
                         "jsonwebtoken":  "^9.0.3",
                         "multer":  "^2.0.2",
                         "nestjs-pino":  "^4.4.1",
                         "pino":  "^10.1.0",
                         "pino-http":  "^11.0.0",
                         "prom-client":  "^15.1.3",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.2",
                         "uuid":  "^13.0.0",
                         "zod":  "^4.1.12"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.2",
                            "@nestjs/cli":  "^11.0.10",
                            "@nestjs/schematics":  "^11.0.7",
                            "@nestjs/testing":  "^11.1.8",
                            "@types/express":  "^5.0.5",
                            "@types/jest":  "^30.0.0",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/multer":  "^2.0.0",
                            "@types/node":  "^24.10.1",
                            "@types/supertest":  "^6.0.3",
                            "@typescript-eslint/eslint-plugin":  "^8.46.4",
                            "@typescript-eslint/parser":  "^8.46.4",
                            "eslint":  "^9.39.1",
                            "eslint-config-prettier":  "^10.1.8",
                            "jest":  "^30.2.0",
                            "prettier":  "^3.6.2",
                            "prisma":  "^6.19.0",
                            "supertest":  "^7.1.4",
                            "ts-jest":  "^29.4.5",
                            "ts-node":  "^10.9.2",
                            "tsconfig-paths":  "^4.2.0",
                            "typescript":  "^5.9.3",
                            "typescript-eslint":  "^8.56.0"
                        }
}
