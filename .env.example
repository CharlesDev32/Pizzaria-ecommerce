# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_NAME=Pizza in Pizza API

# Database and Cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pizza_in_pizza?schema=public
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_TTL=30d
JWT_ISSUER=pizza-in-pizza
JWT_AUDIENCE=pizza-in-pizza-clients

# Security and HTTP
CORS_ALLOWLIST=http://localhost:3000,http://localhost:5173
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AUTH_BRUTE_FORCE_BLOCK_MINUTES=15

# Logging
LOG_LEVEL=debug
LOG_REDACT_PATHS=req.headers.authorization,req.body.password,req.body.refreshToken,res.headers["set-cookie"]

# Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=products
S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp

# Queues / Email
BULLMQ_PREFIX=pizza
MAIL_MODE=mailhog
MAIL_FROM=no-reply@pizzainpizza.local
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Observability
METRICS_ENABLED=true
HEALTHCHECK_DB_TIMEOUT_MS=1000
HEALTHCHECK_REDIS_TIMEOUT_MS=1000
