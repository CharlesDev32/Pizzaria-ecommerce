{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testRegex": "test/integration/.*\\.e2e-spec\\.ts$",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/jest.setup.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node"
}
